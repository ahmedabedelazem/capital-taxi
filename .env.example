NEXT_PUBLIC_APP_NAME="تاكسي العاصمة"
NEXT_PUBLIC_APP_REGION="العريش - شمال سيناء"

# Firebase Web SDK configuration (public values; restrict API key by HTTP referrer in Google Cloud).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-only Firebase Admin credentials (deployment secrets only).
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Internal dispatch worker secret (server-only, minimum 32 random characters).
DISPATCH_WORKER_SECRET=

# Public HTTPS origin used by the trusted dispatch sweep to call the worker.
APP_BASE_URL=https://your-deployment.example
