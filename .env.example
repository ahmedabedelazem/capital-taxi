NEXT_PUBLIC_APP_NAME="تاكسي العاصمة"
NEXT_PUBLIC_APP_REGION="العريش - شمال سيناء"
# Firebase integration is intentionally not configured in this foundation phase.
# Never commit private keys, service-account JSON, or secrets.

# Server-only Firebase Admin credentials (configure in deployment secrets only).
# Set FIREBASE_PROJECT_ID and FIREBASE_SERVICE_ACCOUNT_JSON on the server.
# FIREBASE_SERVICE_ACCOUNT_JSON must be the full service-account JSON string.
# Never prefix these values with NEXT_PUBLIC_ and never commit real values.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
